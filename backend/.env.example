# Copy to .env. Every value points at a service in docker-compose.yml, so a
# fresh clone runs with `docker compose up` and nothing else to configure.

# PostgreSQL
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app

# Redis
REDIS_URL=redis://redis:6379/0

# JWT session-token secret. MUST be set -- the app refuses to start without it.
JWT_SECRET=change-me-to-a-long-random-string

# OpenAI (used by the conversation / message streaming features)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
SYSTEM_PROMPT=You are a helpful assistant.